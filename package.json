{
	"name": "payments-gateway-hub",
	"version": "1.0.0",
	"description": "",
	"private": true,
	"license": "MIT",
	"scripts": {
		"prebuild": "rm -rf dist",
		"build": "nest build -p ./tsconfig.build.json -c ./nest-cli.json -b swc",
		"postbuild": "find dist -name '*.spec.js' -o -name '__tests__' | xargs rm -rf",
		"format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
		"prestart": "npm run build",
		"start": "dotenv -e .env.dev -- nest start",
		"start:dev": "npm run start -- --watch",
		"start:prod": "node --env-file=.env ./dist/main",
		"start:staging": "dotenv -e .env.staging -- nest start",
		"lint": "eslint \"{src,apps,libs,tests}/**/*.ts\" --fix",
		"pretest": "npm run prebuild",
		"test": "dotenv -e .env.test -- vitest run",
		"test:watch": "npm run test -- --watch",
		"test:cov": "npm run test -- --coverage",
		"test:unit": "npm run test -- tests/__unit__",
		"test:unit:watch": "npm run test:unit -- --watch",
		"test:integration": "dotenv -e .env.test -- npm run test -- tests/__integration__",
		"test:integration:watch": "npm run test:integration -- --watch",
		"test:e2e": "npm run test -- tests/__e2e__ --pool=forks --poolOptions.forks.singleFork=true",
		"test:e2e:watch": "npm run test:e2e -- --watch",
		"test:db:up": "docker compose -f docker-compose.test.yml up -d",
		"test:db:down": "docker compose -f docker-compose.test.yml down",
		"db:push:dev": "dotenv -e .env.dev -- prisma db push",
		"db:seed:dev": "dotenv -e .env.dev -- tsx prisma/seed.ts",
		"db:push:test": "dotenv -e .env.test -- prisma db push",
		"db:seed:test": "dotenv -e .env.test -- tsx prisma/seed.ts",
		"test:ci": "./scripts/integration-tests.sh",
		"test:ci:e2e": "./scripts/e2e-tests.sh",
		"test:ci:integration": "./scripts/integration-tests.sh",
		"prepare": "husky install"
	},
	"dependencies": {
		"@aws-sdk/client-sqs": "^3.948.0",
		"@nestjs/axios": "^4.0.1",
		"@nestjs/common": "^10.0.0",
		"@nestjs/config": "^3.2.3",
		"@nestjs/core": "^10.0.0",
		"@nestjs/platform-express": "^10.0.0",
		"@nestjs/schedule": "^6.1.0",
		"@nestjs/swagger": "^8.1.0",
		"@node-rs/bcrypt": "^1.10.7",
		"@paralleldrive/cuid2": "^2.2.2",
		"@prisma/adapter-pg": "7.0.1",
		"@prisma/client": "7.0.1",
		"axios": "^1.13.2",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"date-fns": "^4.1.0",
		"express": "^4.19.2",
		"jsonwebtoken": "^9.0.2",
		"module-alias": "^2.2.3",
		"multer": "^2.0.2",
		"nestjs-pino": "^4.5.0",
		"pg": "^8.16.3",
		"pino": "^10.1.0",
		"pino-http": "^11.0.0",
		"reflect-metadata": "^0.2.0",
		"rxjs": "^7.8.1"
	},
	"devDependencies": {
		"@faker-js/faker": "^8.4.1",
		"@nestjs/cli": "^10.0.0",
		"@nestjs/schematics": "^10.0.0",
		"@nestjs/testing": "^10.0.0",
		"@swc/cli": "^0.3.14",
		"@swc/core": "^1.7.10",
		"@swc/helpers": "^0.5.8",
		"@tsconfig/node-lts": "^20.1.3",
		"@types/express": "^4.17.21",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/module-alias": "^2.0.4",
		"@types/multer": "^2.0.0",
		"@types/node": "^20.3.1",
		"@types/pg": "^8.15.6",
		"@types/supertest": "^6.0.3",
		"@typescript-eslint/eslint-plugin": "^8.32.0",
		"@typescript-eslint/parser": "^8.32.0",
		"@vitest/coverage-v8": "3.2.4",
		"dotenv": "^17.2.3",
		"dotenv-cli": "^7.4.2",
		"eslint": "8.57.1",
		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin-import-helpers": "^1.3.1",
		"eslint-plugin-prettier": "^5.0.0",
		"husky": "^8.0.0",
		"lint-staged": "^15.2.11",
		"prettier": "^3.0.0",
		"prisma": "7.0.1",
		"source-map-support": "^0.5.21",
		"supertest": "^7.1.4",
		"ts-loader": "^9.4.3",
		"ts-node": "^10.9.1",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.21.0",
		"typescript": "^5.1.3",
		"unplugin-swc": "^1.5.5",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^3.2.4"
	}
}
